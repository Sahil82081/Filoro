# ==========================================
# Fileora Production Environment Configuration
# ==========================================

# Port mappings on host
FRONTEND_PORT=80
BACKEND_PORT=5000

# Backend Configuration
NODE_ENV=production
PORT=5000
CORS_ORIGIN=*
MAX_FILE_SIZE_MB=50
FILE_TTL_MINUTES=30

# Frontend Configuration
# Leave as /api when using standard reverse proxy setup (recommended)
VITE_API_URL=/api
